# Phase 1: IP-based testing — plain HTTP, any host header.
# Switch to Caddyfile.prod once sandbox.environnets.com DNS is set.
:80 {
    encode gzip
    # Auto-redirect bare visits to the xpra HTML5 client with autoconnect
    @root path /
    redir @root /index.html?autoconnect=true&path=/&keyboard=true permanent

    reverse_proxy 127.0.0.1:14500
}

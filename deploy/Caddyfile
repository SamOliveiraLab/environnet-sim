# Phase 1: IP-based testing — plain HTTP, any host header.
# Switch to Caddyfile.prod once sandbox.environnets.com DNS is set.
:80 {
    encode gzip

    # Auto-redirect bare GET / to the xpra HTML5 client with autoconnect.
    # Crucially: do NOT match WebSocket upgrade requests, otherwise the
    # WS handshake gets a 301 and fails.
    @bare_root {
        path /
        not header Connection *Upgrade*
    }
    redir @bare_root /index.html?autoconnect=true permanent

    reverse_proxy 127.0.0.1:14500
}
